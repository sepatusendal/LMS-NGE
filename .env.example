# Supabase project settings (Project Settings > API in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — use the Supabase "Connection pooling" string (port 6543) for DATABASE_URL
# and the direct connection string (port 5432) for DIRECT_URL (needed for migrations)
DATABASE_URL=
DIRECT_URL=

# Google Drive API — authenticates as a real Google account via OAuth
# refresh token, not a service account (standalone service accounts get no
# Drive storage quota). Get the client id/secret from Google Cloud Console
# (APIs & Services > Credentials), then run scripts/google-oauth-setup.ts
# once to obtain GOOGLE_OAUTH_REFRESH_TOKEN.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
