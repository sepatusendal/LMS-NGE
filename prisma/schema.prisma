generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  COORDINATOR
  TEACHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ParentReportStatus {
  DRAFT
  GENERATED
}

enum ObjectivesAchieved {
  YES
  PARTIALLY
  NO
}

enum AnnouncementType {
  INFO
  SUCCESS
  CELEBRATION
  MAINTENANCE
}

enum AnnouncementDisplayMode {
  BANNER
  POPUP
}

// ─────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────

/// Mirrors auth.users — id matches the Supabase Auth user id 1:1.
model User {
  id        String    @id @db.Uuid
  email     String    @unique
  fullName  String
  role      Role
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  teacher                 Teacher?
  parentReportsCreated    ParentReport[]     @relation("ParentReportGeneratedBy")
  announcementsAuthored   Announcement[]
  announcementReads       AnnouncementRead[]

  @@map("users")
}

model Teacher {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @unique @db.Uuid
  tutorId   String?   @unique // external tutor ID, disambiguates teachers/tutors with the same or similar name — not a foreign key
  feePerMeeting Int? // Rupiah paid per meeting actually attended (CheckIn), admin-editable; null = not set
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  classesAsPrimary    Class[]          @relation("ClassPrimaryTeacher")
  meetingsAssigned    Meeting[]        @relation("MeetingAssignedTeacher")
  meetingsActual      Meeting[]        @relation("MeetingActualTeacher")
  lessonPlansAuthored LessonPlan[]     @relation("LessonPlanAuthor")
  checkIns            CheckIn[]
  checkOuts           CheckOut[]
  reportsAsOriginal   TeachingReport[] @relation("ReportOriginalTeacher")
  reportsAsSubstitute TeachingReport[] @relation("ReportSubstituteTeacher")
  scheduleOverrides   ClassScheduleOverride[]

  @@map("teachers")
}

// ─────────────────────────────────────────────────────────────
// Master Data
// ─────────────────────────────────────────────────────────────

model School {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  address   String?
  picName   String?
  picPhone  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  students Student[]
  classes  Class[]
  holidays Holiday[]

  @@map("schools")
}

/// Admin-managed non-teaching day. `schoolId = null` applies to every
/// school (national holidays / cuti bersama); a set schoolId scopes it to
/// just that school. Classes whose scheduleDaysOfWeek/override would
/// otherwise meet on this date are treated as not meeting (see the
/// holiday-aware resolution in meetings/queries.ts, monitoring/queries.ts,
/// and lesson-plans/queries.ts, which all mirror the same "which classes
/// meet on date X" logic independently).
model Holiday {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date      DateTime @db.Date
  name      String
  schoolId  String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  school School? @relation(fields: [schoolId], references: [id])

  @@unique([date, schoolId])
  @@index([date])
  @@map("holidays")
}

model Student {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String    @db.Uuid
  fullName  String
  nis       String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  school          School            @relation(fields: [schoolId], references: [id])
  enrollments     ClassEnrollment[]
  attendances     Attendance[]
  followUps       StudentFollowUp[]
  progressRecords ProgressRecord[]
  parentReports   ParentReport[]

  @@index([schoolId])
  @@map("students")
}

enum CurriculumReportFormat {
  STANDARD
  ALBRIGHT
}

model Curriculum {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  gradeLevel  String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  // Reference module (silabus/materi PDF) for this program, stored in Google
  // Drive — not Supabase Storage — and shown to teachers as a read-only
  // reference when they write a lesson plan for a class on this curriculum.
  moduleDriveFileId String?
  moduleFileName    String?
  moduleFileSize    Int?
  moduleUpdatedAt   DateTime? @db.Timestamptz(3)

  // STANDARD renders the usual Lesson Plan / Daily Teaching Report forms.
  // ALBRIGHT (a licensed curriculum provider) requires a different teaching
  // report field set — see 20260824000000_albright_curriculum_report_format.
  reportFormat CurriculumReportFormat @default(STANDARD)

  classes Class[]

  @@map("curriculums")
}

enum ClassType {
  REGULAR
  TEACHER_TRAINING
}

model Class {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String    @db.Uuid
  curriculumId       String?   @db.Uuid
  teacherId          String    @db.Uuid
  name               String
  classType          ClassType @default(REGULAR) // REGULAR = student classes, TEACHER_TRAINING = Guru & Staff English course — kept in separate admin submenus, never listed together
  room               String?
  scheduleDaysOfWeek Int[] // 0 = Sunday .. 6 = Saturday; classes often meet 2x/week — kept in sync with scheduleSlots
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)

  school      School            @relation(fields: [schoolId], references: [id])
  curriculum  Curriculum?       @relation(fields: [curriculumId], references: [id])
  teacher     Teacher           @relation("ClassPrimaryTeacher", fields: [teacherId], references: [id])
  enrollments ClassEnrollment[]
  lessonPlans LessonPlan[]
  scheduleOverrides ClassScheduleOverride[]
  scheduleSlots     ClassScheduleSlot[]

  @@index([schoolId])
  @@index([teacherId])
  @@map("classes")
}

/// Per-day time for a Class's own regular schedule (context.md: classes meet
/// on 1-2+ days a week, not necessarily at the same time — e.g. Senin
/// 08:00-09:00, Kamis 15:00-16:00). One row per day the class meets, always
/// under the class's own primary teacher. Distinct from
/// ClassScheduleOverride, which represents a DIFFERENT teacher covering a
/// day (substitute scenario).
model ClassScheduleSlot {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId   String   @db.Uuid
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  class Class @relation(fields: [classId], references: [id])

  @@unique([classId, dayOfWeek])
  @@map("class_schedule_slots")
}

/// Per-day exception to a Class's default schedule/teacher (context.md:
/// some classes meet with a different tutor on one of their weekly days —
/// e.g. "Houstan": Bu Eni Wed 14:30-15:30, Latifa Sat 07:30-08:30). Absence
/// of a row for a given dayOfWeek means the class's own teacherId and
/// ClassScheduleSlot for that day apply as-is.
model ClassScheduleOverride {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId    String   @db.Uuid
  dayOfWeek  Int // 0 = Sunday .. 6 = Saturday
  startTime  String // "HH:mm"
  endTime    String // "HH:mm"
  teacherId  String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  class   Class   @relation(fields: [classId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([classId, dayOfWeek])
  @@index([teacherId])
  @@map("class_schedule_overrides")
}

model ClassEnrollment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String    @db.Uuid
  classId      String    @db.Uuid
  enrolledAt   DateTime  @default(now()) @db.Timestamptz(3)
  unenrolledAt DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
  @@map("class_enrollments")
}

// ─────────────────────────────────────────────────────────────
// Lesson Plan & Meetings
//
// LessonPlan belongs to a Class and is authored end-to-end (schedule +
// pedagogical content) by the Teacher assigned to that class, at least
// two weeks ahead (context.md Section 5.5). Admin/Coordinator monitor
// compliance but do not author content. Meeting is the operational
// realization of a LessonPlan on a specific date, and is what
// Check-in/Attendance/Check-out/Teaching Report all attach to
// (context.md Section 4).
// ─────────────────────────────────────────────────────────────

model LessonPlan {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId            String   @db.Uuid
  createdByTeacherId String   @db.Uuid
  meetingNumber      Int
  week               Int
  scheduledDate      DateTime @db.Date

  level                    String? // SD / SMP / SMA
  topic                    String
  /// Numbered list — teacher fills 3 by default and can add more.
  learningObjectives       String[] @default([])
  skills                   String[] @default([]) // Listening, Speaking, Writing, Reading
  method                   String?
  procedure                String? // PPP / ESA
  materialsRequired        String[] @default([])
  vocabularyFocus          String?
  /// Array of { stage, activity, media, assessment } — per-lesson freeform
  /// stage breakdown, not shared/normalized across lessons.
  stages                   Json?
  questionsToAsk           String[] @default([])
  differentiationSupport   String?
  differentiationExtension String?
  differentiationHomework  String?
  /// Learning module attached to this lesson plan (PDF, uploaded to Drive) —
  /// same id/filename pattern as check-in/report photos.
  moduleDriveFileId        String?
  moduleFileName           String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  class            Class    @relation(fields: [classId], references: [id])
  createdByTeacher Teacher  @relation("LessonPlanAuthor", fields: [createdByTeacherId], references: [id])
  meeting          Meeting?

  @@unique([classId, meetingNumber])
  @@index([classId, scheduledDate])
  @@map("lesson_plans")
}

model Meeting {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonPlanId      String        @unique @db.Uuid
  assignedTeacherId String        @db.Uuid
  actualTeacherId   String?       @db.Uuid
  substituteReason  String?
  status            MeetingStatus @default(SCHEDULED)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  lessonPlan      LessonPlan @relation(fields: [lessonPlanId], references: [id])
  assignedTeacher Teacher    @relation("MeetingAssignedTeacher", fields: [assignedTeacherId], references: [id])
  actualTeacher   Teacher?   @relation("MeetingActualTeacher", fields: [actualTeacherId], references: [id])

  checkIn        CheckIn?
  checkOut       CheckOut?
  attendances    Attendance[]
  teachingReport TeachingReport?

  @@index([status])
  @@map("meetings")
}

// ─────────────────────────────────────────────────────────────
// Daily Teaching Workflow (context.md Section 5.1–5.4)
// ─────────────────────────────────────────────────────────────

model CheckIn {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId        String   @unique @db.Uuid
  teacherId        String   @db.Uuid
  checkInTime      DateTime @default(now()) @db.Timestamptz(3)
  gpsLat           Float?
  gpsLng           Float?
  photoDriveFileId String?
  photoFileName    String?
  notes            String?
  isLate           Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@map("check_ins")
}

model CheckOut {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId        String   @unique @db.Uuid
  teacherId        String   @db.Uuid
  checkOutTime     DateTime @default(now()) @db.Timestamptz(3)
  durationMinutes  Int
  photoDriveFileId String?
  photoFileName    String?
  notes            String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@map("check_outs")
}

model Attendance {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId String           @db.Uuid
  studentId String           @db.Uuid
  status    AttendanceStatus
  notes     String?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([meetingId, studentId])
  @@index([studentId])
  @@map("attendances")
}

/// One report per meeting — enforced via the unique meetingId (context.md Section 5.4).
/// Field set mirrors the current Daily Teaching Report form (see reference-data/).
model TeachingReport {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId           String   @unique @db.Uuid
  originalTeacherId   String   @db.Uuid
  substituteTeacherId String?  @db.Uuid
  replacementReason   String?
  actualTeachingDate  DateTime @db.Date

  skills               String[]            @default([]) // Listening, Speaking, Writing, Reading
  objectivesAchieved   ObjectivesAchieved? // derived from `objectives` below, not picked directly
  whatWentWell         String?
  whatNeedsImprovement String?
  /// Concrete plan for how whatNeedsImprovement will be addressed — required
  /// client-side whenever whatNeedsImprovement is filled in.
  actionPlan           String?
  nextLessonNotes      String?
  homeworkAssigned     String?
  photoDriveFileId     String?
  photoFileName        String?
  summary              String?

  // Albright-curriculum-only fields (curriculums.reportFormat = ALBRIGHT) —
  // replace skills/objectives/whatWentWell/whatNeedsImprovement/actionPlan/
  // nextLessonNotes in that curriculum's teaching report form.
  // "Homework" reuses homeworkAssigned above rather than a new column.
  languageSkillsFocus String?
  activitiesLog       String?
  resourcesUsed       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  meeting           Meeting                    @relation(fields: [meetingId], references: [id])
  originalTeacher   Teacher                    @relation("ReportOriginalTeacher", fields: [originalTeacherId], references: [id])
  substituteTeacher Teacher?                   @relation("ReportSubstituteTeacher", fields: [substituteTeacherId], references: [id])
  followUps         StudentFollowUp[]
  progressRecords   ProgressRecord[]
  objectives        ReportLearningObjective[]

  @@index([actualTeachingDate])
  @@map("teaching_reports")
}

/// One row per lesson-plan learning objective, snapshotted at report time —
/// objectives are freeform strings on LessonPlan.learningObjectives, not a
/// normalized/id'd table, so the text is stored directly rather than an FK.
model ReportLearningObjective {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teachingReportId String   @db.Uuid
  objectiveText    String
  achieved         Boolean
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  teachingReport TeachingReport @relation(fields: [teachingReportId], references: [id])

  @@index([teachingReportId])
  @@map("report_learning_objectives")
}

model StudentFollowUp {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teachingReportId String    @db.Uuid
  studentId        String    @db.Uuid
  note             String
  resolvedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  teachingReport TeachingReport @relation(fields: [teachingReportId], references: [id])
  student        Student        @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@map("student_follow_ups")
}

/// Appended per meeting, derived from the Teaching Report — never manually entered
/// (context.md Section 2.3: automation over manual input).
model ProgressRecord {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String   @db.Uuid
  teachingReportId String   @db.Uuid
  skillArea        String?
  note             String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  student        Student        @relation(fields: [studentId], references: [id])
  teachingReport TeachingReport @relation(fields: [teachingReportId], references: [id])

  @@index([studentId])
  @@map("progress_records")
}

// ─────────────────────────────────────────────────────────────
// Parent Report (context.md Section 9)
// ─────────────────────────────────────────────────────────────

model ParentReport {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId            String             @db.Uuid
  periodMonth          Int
  periodYear           Int
  teacherCommentsDraft String?
  teacherCommentsFinal String?
  status               ParentReportStatus @default(DRAFT)
  pdfDriveFileId       String?
  pdfFileName          String?
  generatedByUserId    String?            @db.Uuid
  generatedAt          DateTime?          @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  student     Student @relation(fields: [studentId], references: [id])
  generatedBy User?   @relation("ParentReportGeneratedBy", fields: [generatedByUserId], references: [id])

  @@unique([studentId, periodMonth, periodYear])
  @@map("parent_reports")
}

// ─────────────────────────────────────────────────────────────
// Announcements (admin-authored, dismissible banner for all roles)
// ─────────────────────────────────────────────────────────────

model Announcement {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  body            String
  type            AnnouncementType        @default(INFO)
  displayMode     AnnouncementDisplayMode @default(BANNER)
  isActive        Boolean          @default(true)
  createdByUserId String           @db.Uuid
  expiresAt       DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  createdBy User               @relation(fields: [createdByUserId], references: [id])
  reads     AnnouncementRead[]

  @@index([isActive])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  announcementId String   @db.Uuid
  userId         String   @db.Uuid
  readAt         DateTime @default(now()) @db.Timestamptz(3)

  announcement Announcement @relation(fields: [announcementId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}
