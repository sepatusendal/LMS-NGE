generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  COORDINATOR
  TEACHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ParentReportStatus {
  DRAFT
  GENERATED
}

enum ObjectivesAchieved {
  YES
  PARTIALLY
  NO
}

// ─────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────

/// Mirrors auth.users — id matches the Supabase Auth user id 1:1.
model User {
  id        String    @id @db.Uuid
  email     String    @unique
  fullName  String
  role      Role
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  teacher              Teacher?
  parentReportsCreated ParentReport[] @relation("ParentReportGeneratedBy")

  @@map("users")
}

model Teacher {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @unique @db.Uuid
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  classesAsPrimary    Class[]          @relation("ClassPrimaryTeacher")
  meetingsAssigned    Meeting[]        @relation("MeetingAssignedTeacher")
  meetingsActual      Meeting[]        @relation("MeetingActualTeacher")
  lessonPlansAuthored LessonPlan[]     @relation("LessonPlanAuthor")
  checkIns            CheckIn[]
  checkOuts           CheckOut[]
  reportsAsOriginal   TeachingReport[] @relation("ReportOriginalTeacher")
  reportsAsSubstitute TeachingReport[] @relation("ReportSubstituteTeacher")
  scheduleOverrides   ClassScheduleOverride[]

  @@map("teachers")
}

// ─────────────────────────────────────────────────────────────
// Master Data
// ─────────────────────────────────────────────────────────────

model School {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  address   String?
  picName   String?
  picPhone  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  students Student[]
  classes  Class[]

  @@map("schools")
}

model Student {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String    @db.Uuid
  fullName  String
  nis       String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  school          School            @relation(fields: [schoolId], references: [id])
  enrollments     ClassEnrollment[]
  attendances     Attendance[]
  followUps       StudentFollowUp[]
  progressRecords ProgressRecord[]
  parentReports   ParentReport[]

  @@index([schoolId])
  @@map("students")
}

model Curriculum {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  gradeLevel  String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  classes Class[]

  @@map("curriculums")
}

model Class {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String    @db.Uuid
  curriculumId       String?   @db.Uuid
  teacherId          String    @db.Uuid
  name               String
  room               String?
  scheduleDaysOfWeek Int[] // 0 = Sunday .. 6 = Saturday; classes often meet 2x/week — kept in sync with scheduleSlots
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)

  school      School            @relation(fields: [schoolId], references: [id])
  curriculum  Curriculum?       @relation(fields: [curriculumId], references: [id])
  teacher     Teacher           @relation("ClassPrimaryTeacher", fields: [teacherId], references: [id])
  enrollments ClassEnrollment[]
  lessonPlans LessonPlan[]
  scheduleOverrides ClassScheduleOverride[]
  scheduleSlots     ClassScheduleSlot[]

  @@index([schoolId])
  @@index([teacherId])
  @@map("classes")
}

/// Per-day time for a Class's own regular schedule (context.md: classes meet
/// on 1-2+ days a week, not necessarily at the same time — e.g. Senin
/// 08:00-09:00, Kamis 15:00-16:00). One row per day the class meets, always
/// under the class's own primary teacher. Distinct from
/// ClassScheduleOverride, which represents a DIFFERENT teacher covering a
/// day (substitute scenario).
model ClassScheduleSlot {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId   String   @db.Uuid
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  class Class @relation(fields: [classId], references: [id])

  @@unique([classId, dayOfWeek])
  @@map("class_schedule_slots")
}

/// Per-day exception to a Class's default schedule/teacher (context.md:
/// some classes meet with a different tutor on one of their weekly days —
/// e.g. "Houstan": Bu Eni Wed 14:30-15:30, Latifa Sat 07:30-08:30). Absence
/// of a row for a given dayOfWeek means the class's own teacherId and
/// ClassScheduleSlot for that day apply as-is.
model ClassScheduleOverride {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId    String   @db.Uuid
  dayOfWeek  Int // 0 = Sunday .. 6 = Saturday
  startTime  String // "HH:mm"
  endTime    String // "HH:mm"
  teacherId  String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  class   Class   @relation(fields: [classId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([classId, dayOfWeek])
  @@index([teacherId])
  @@map("class_schedule_overrides")
}

model ClassEnrollment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String    @db.Uuid
  classId      String    @db.Uuid
  enrolledAt   DateTime  @default(now()) @db.Timestamptz(3)
  unenrolledAt DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
  @@map("class_enrollments")
}

// ─────────────────────────────────────────────────────────────
// Lesson Plan & Meetings
//
// LessonPlan belongs to a Class and is authored end-to-end (schedule +
// pedagogical content) by the Teacher assigned to that class, at least
// two weeks ahead (context.md Section 5.5). Admin/Coordinator monitor
// compliance but do not author content. Meeting is the operational
// realization of a LessonPlan on a specific date, and is what
// Check-in/Attendance/Check-out/Teaching Report all attach to
// (context.md Section 4).
// ─────────────────────────────────────────────────────────────

model LessonPlan {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId            String   @db.Uuid
  createdByTeacherId String   @db.Uuid
  meetingNumber      Int
  week               Int
  scheduledDate      DateTime @db.Date

  level                    String? // SD / SMP / SMA
  topic                    String
  learningObjectives       String?
  skills                   String[] @default([]) // Listening, Speaking, Writing, Reading
  method                   String?
  procedure                String? // PPP / ESA
  materialsRequired        String[] @default([])
  vocabularyFocus          String?
  /// Array of { stage, tutorActivity, studentActivity, media, assessment } —
  /// per-lesson freeform stage breakdown, not shared/normalized across lessons.
  stages                   Json?
  questionsToAsk           String[] @default([])
  differentiationSupport   String?
  differentiationExtension String?
  differentiationHomework  String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  class            Class    @relation(fields: [classId], references: [id])
  createdByTeacher Teacher  @relation("LessonPlanAuthor", fields: [createdByTeacherId], references: [id])
  meeting          Meeting?

  @@unique([classId, meetingNumber])
  @@index([classId, scheduledDate])
  @@map("lesson_plans")
}

model Meeting {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonPlanId      String        @unique @db.Uuid
  assignedTeacherId String        @db.Uuid
  actualTeacherId   String?       @db.Uuid
  substituteReason  String?
  status            MeetingStatus @default(SCHEDULED)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  lessonPlan      LessonPlan @relation(fields: [lessonPlanId], references: [id])
  assignedTeacher Teacher    @relation("MeetingAssignedTeacher", fields: [assignedTeacherId], references: [id])
  actualTeacher   Teacher?   @relation("MeetingActualTeacher", fields: [actualTeacherId], references: [id])

  checkIn        CheckIn?
  checkOut       CheckOut?
  attendances    Attendance[]
  teachingReport TeachingReport?

  @@index([status])
  @@map("meetings")
}

// ─────────────────────────────────────────────────────────────
// Daily Teaching Workflow (context.md Section 5.1–5.4)
// ─────────────────────────────────────────────────────────────

model CheckIn {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId        String   @unique @db.Uuid
  teacherId        String   @db.Uuid
  checkInTime      DateTime @default(now()) @db.Timestamptz(3)
  gpsLat           Float?
  gpsLng           Float?
  photoDriveFileId String?
  photoFileName    String?
  notes            String?
  isLate           Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@map("check_ins")
}

model CheckOut {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId        String   @unique @db.Uuid
  teacherId        String   @db.Uuid
  checkOutTime     DateTime @default(now()) @db.Timestamptz(3)
  durationMinutes  Int
  photoDriveFileId String?
  photoFileName    String?
  notes            String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@map("check_outs")
}

model Attendance {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId String           @db.Uuid
  studentId String           @db.Uuid
  status    AttendanceStatus
  notes     String?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([meetingId, studentId])
  @@index([studentId])
  @@map("attendances")
}

/// One report per meeting — enforced via the unique meetingId (context.md Section 5.4).
/// Field set mirrors the current Daily Teaching Report form (see reference-data/).
model TeachingReport {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId           String   @unique @db.Uuid
  originalTeacherId   String   @db.Uuid
  substituteTeacherId String?  @db.Uuid
  replacementReason   String?
  actualTeachingDate  DateTime @db.Date

  skills               String[]            @default([]) // Listening, Speaking, Writing, Reading
  objectivesAchieved   ObjectivesAchieved?
  whatWentWell         String?
  whatNeedsImprovement String?
  nextLessonNotes      String?
  homeworkAssigned     String?
  photoDriveFileId     String?
  photoFileName        String?
  summary              String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  meeting           Meeting           @relation(fields: [meetingId], references: [id])
  originalTeacher   Teacher           @relation("ReportOriginalTeacher", fields: [originalTeacherId], references: [id])
  substituteTeacher Teacher?          @relation("ReportSubstituteTeacher", fields: [substituteTeacherId], references: [id])
  followUps         StudentFollowUp[]
  progressRecords   ProgressRecord[]

  @@index([actualTeachingDate])
  @@map("teaching_reports")
}

model StudentFollowUp {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teachingReportId String    @db.Uuid
  studentId        String    @db.Uuid
  note             String
  resolvedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  teachingReport TeachingReport @relation(fields: [teachingReportId], references: [id])
  student        Student        @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@map("student_follow_ups")
}

/// Appended per meeting, derived from the Teaching Report — never manually entered
/// (context.md Section 2.3: automation over manual input).
model ProgressRecord {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String   @db.Uuid
  teachingReportId String   @db.Uuid
  skillArea        String?
  note             String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  student        Student        @relation(fields: [studentId], references: [id])
  teachingReport TeachingReport @relation(fields: [teachingReportId], references: [id])

  @@index([studentId])
  @@map("progress_records")
}

// ─────────────────────────────────────────────────────────────
// Parent Report (context.md Section 9)
// ─────────────────────────────────────────────────────────────

model ParentReport {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId            String             @db.Uuid
  periodMonth          Int
  periodYear           Int
  teacherCommentsDraft String?
  teacherCommentsFinal String?
  status               ParentReportStatus @default(DRAFT)
  pdfDriveFileId       String?
  pdfFileName          String?
  generatedByUserId    String?            @db.Uuid
  generatedAt          DateTime?          @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  student     Student @relation(fields: [studentId], references: [id])
  generatedBy User?   @relation("ParentReportGeneratedBy", fields: [generatedByUserId], references: [id])

  @@unique([studentId, periodMonth, periodYear])
  @@map("parent_reports")
}
