# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# credentials — never commit
CREDENTIALS.md
CREDENTIALS.staging.md
# Google service account key files (gcloud's default download naming:
# <project-id>-<key-id>.json), e.g. nge-lms-504705-6861b4fcc342.json
/*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
*.pem
service-account*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.staging.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# reference data — real operational data, not for source control
/reference-data

# local testing notes — contains test account credentials, repo is public
/TESTING.md

# Claude Code session state
.claude/scheduled_tasks.lock

# local PDF preview output from scripts/render-parent-report-preview.ts
/parent-report-preview.pdf
